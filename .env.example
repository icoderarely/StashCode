# Neon PostgreSQL
#
# DATABASE_URL — pooled endpoint (hostname contains "-pooler"). Used by the app
# at runtime via the Prisma driver adapter in src/lib/prisma.ts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# DIRECT_URL — unpooled endpoint (no "-pooler"). Used by the Prisma CLI for
# migrations; the pooled endpoint can't hold the session locks they need.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"
